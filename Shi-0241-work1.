<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>创建你的衣橱</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:"Microsoft Yahei",sans-serif;}
body{background:#ffe8f0;padding:30px;color:#883355;}
h1{text-align:center;color:#d86b94;margin-bottom:30px;letter-spacing:2px;}
.container{max-width:900px;margin:0 auto;background:#fff0f6;padding:25px;border-radius:20px;box-shadow:0 4px 12px #f8c8da;}
table{width:100%;border-collapse:separate;border-spacing:8px;}
td,th{background:#fff;border-radius:14px;padding:12px;text-align:center;border:2px solid #f7c6d9;min-height:70px;vertical-align:middle;}
th{background:#f9d2e2;font-weight:bold;}
select{padding:8px 12px;border-radius:10px;border:2px solid #f2b8d0;background:#fff;color:#883355;font-size:15px;}
.add-btn{margin-top:6px;background:#f8a8c5;color:#fff;border:none;width:32px;height:32px;border-radius:50%;font-size:18px;cursor:pointer;transition:0.2s;}
.add-btn:hover{background:#ec87ad;}
.tip{margin-top:20px;text-align:center;font-size:14px;color:#b86486;}

/*穿搭模块*/
.outfit-generator{margin-top:30px;background:#fff;border-radius:20px;padding:20px;border:2px solid #f7c6d9;}
.gen-title{font-size:20px;text-align:center;color:#d86b94;margin-bottom:16px;}
.control-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:16px;}
.gen-btn{padding:9px 18px;border:none;border-radius:12px;background:#f8a8c5;color:#fff;font-size:16px;cursor:pointer;}
.gen-btn:hover{background:#ec87ad;}

/*小人选择*/
.model-selector{display:flex;justify-content:center;gap:12px;margin-bottom:16px;}
.model-wrap-box{display:flex;justify-content:center;gap:14px;}
.pixel-model-wrap{width:160px;height:260px;border-radius:16px;position:relative;overflow:hidden;border:2px solid #f2b8d0;transition:0.3s;}
.pixel-model-wrap.dim{opacity:0.45;}
.scene-bg{width:100%;height:100%;position:absolute;z-index:1;}
.pixel-model{width:72px;height:180px;position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:2;}
.pixel-layer{position:absolute;left:0;top:0;width:72px;height:180px;}
.body{clip-path:polygon(28px 0,44px 0,52px 14,56px 42,54px 78,48px 148,42px 162,30px 162,24px 148,18px 78,16px 42,20px 14);}
.head{width:30px;height:30px;border-radius:50%;position:absolute;left:21px;top:-8px;}
/*3个小人肤色*/
.m1 .body,.m1 .head{background:#ffd6bc;}
.m2 .body,.m2 .head{background:#f5c9a7;}
.m3 .body,.m3 .head{background:#e0b792;}
/*衣服样式*/
.top-han{background:#f8c8da;clip-path:polygon(22px 24,50px 24,52px 64,46px 94,26px 94,20px 64);}
.top-korean{background:#dcecf8;clip-path:polygon(24px 26,48px 26,50px 60,44px 90,28px 90,22px 60);}
.bottom-skirt{background:#b886c9;clip-path:polygon(20px 78,52px 78,56px 138,16px 138);}
.bottom-pants{background:#667799;clip-path:polygon(24px 78,48px 78,46px 140,40px 140,38px 100,34px 100,32px 140,26px 140);}
/*场景*/
.scene-bedroom{background:linear-gradient(#ffe6ee,#f9d9e8);}
.scene-street{background:linear-gradient(#b9d8f0,#e8f1f8);}
.scene-cafe{background:linear-gradient(#f2e4d8,#e8d4c4);}

/*弹窗*/
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:100;align-items:center;justify-content:center;}
.modal.active{display:flex;}
.modal-box{background:#fff;padding:24px;border-radius:18px;width:420px;border:2px solid #f7c6d9;}
.modal button{margin-top:12px;padding:8px 16px;border:none;border-radius:10px;background:#f8a8c5;color:#fff;cursor:pointer;}
</style>
</head>
<body>
<h1>♡ 创建你的衣橱 ♡</h1>
<div class="container">
<table>
<thead><tr><th>商品</th><th>淡色系</th><th>深色系</th></tr></thead>
<tbody>
<tr><td>上衣</td><td><button class="add-btn" data-type="top">+</button></td><td><button class="add-btn" data-type="top">+</button></td></tr>
<tr><td>下裙</td><td><button class="add-btn" data-type="skirt">+</button></td><td><button class="add-btn" data-type="skirt">+</button></td></tr>
<tr><td>下裤</td><td><button class="add-btn" data-type="pants">+</button></td><td><button class="add-btn" data-type="pants">+</button></td></tr>
<tr><td>连衣裙</td><td><button class="add-btn" data-type="dress">+</button></td><td><button class="add-btn" data-type="dress">+</button></td></tr>
<tr><td>外套</td><td><button class="add-btn" data-type="outer">+</button></td><td><button class="add-btn" data-type="outer">+</button></td></tr>
<tr><td>配饰<br><select><option>颈饰</option><option>手饰</option><option>腰饰</option><option>脚饰</option><option>耳饰</option></select></td><td><button class="add-btn" data-type="acc">+</button></td><td><button class="add-btn" data-type="acc">+</button></td></tr>
</tbody>
</table>
<div class="tip">⊕ 点击 + 上传衣服照片，网站自动识别淡/深色</div>

<div class="outfit-generator">
<div class="gen-title">✨ 一键生成穿搭</div>
<div class="control-row">
<select id="styleSelect">
<option value="asian">亚裔/轻亚裔</option>
<option value="american">美式</option>
<option value="thai">泰式</option>
<option value="ethnic">民族风</option>
<option value="chinese">中式</option>
<option value="korean">韩系</option>
<option value="japanese">日系</option>
<option value="jk">JK/Lolita</option>
</select>
<select id="sceneSelect">
<option value="scene-bedroom">卧室</option>
<option value="scene-street">街头</option>
<option value="scene-cafe">咖啡馆</option>
</select>
<button class="gen-btn" id="genOutfitBtn">生成穿搭</button>
</div>
<div class="model-selector">
<label><input type="radio" name="modelSel" value="1" checked>小人1</label>
<label><input type="radio" name="modelSel" value="2">小人2</label>
<label><input type="radio" name="modelSel" value="3">小人3</label>
</div>
<div class="model-wrap-box">
<div class="pixel-model-wrap" id="wrap1">
<div class="scene-bg" id="sceneBg1"></div>
<div class="pixel-model m1">
<div class="pixel-layer body"></div><div class="head"></div>
<div class="pixel-layer top" id="layerTop1"></div>
<div class="pixel-layer bottom" id="layerBottom1"></div>
</div>
</div>
<div class="pixel-model-wrap" id="wrap2">
<div class="scene-bg" id="sceneBg2"></div>
<div class="pixel-model m2">
<div class="pixel-layer body"></div><div class="head"></div>
<div class="pixel-layer top" id="layerTop2"></div>
<div class="pixel-layer bottom" id="layerBottom2"></div>
</div>
</div>
<div class="pixel-model-wrap" id="wrap3">
<div class="scene-bg" id="sceneBg3"></div>
<div class="pixel-model m3">
<div class="pixel-layer body"></div><div class="head"></div>
<div class="pixel-layer top" id="layerTop3"></div>
<div class="pixel-layer bottom" id="layerBottom3"></div>
</div>
</div>
</div>
</div>
</div>

<!--上传弹窗-->
<div class="modal" id="uploadModal">
<div class="modal-box">
<h3>上传衣服图片</h3>
<input type="file" id="imgFile" accept="image/*">
<p>风格标签(逗号分隔)：<br><input id="styleInput" placeholder="韩系,中式"></p>
<p id="detectResult"></p>
<button id="saveCloth">保存到衣橱</button>
</div>
</div>

<script>
let wardrobe = [];
let currentAddType = "";
const styleRule = {
    chinese:{top:"top-han",bottom:"bottom-skirt"},
    korean:{top:"top-korean",bottom:"bottom-skirt"},
    american:{top:"top-korean",bottom:"bottom-pants"},
    asian:{top:"top-korean",bottom:"bottom-pants"},
    thai:{top:"top-han",bottom:"bottom-pants"},
    ethnic:{top:"top-han",bottom:"bottom-skirt"},
    japanese:{top:"top-korean",bottom:"bottom-skirt"},
    jk:{top:"top-korean",bottom:"bottom-skirt"},
};
const modal = document.getElementById("uploadModal");
const imgFileInput = document.getElementById("imgFile");
const detectResultText = document.getElementById("detectResult");
const styleInput = document.getElementById("styleInput");
const radios = document.querySelectorAll('input[name="modelSel"]');

// 选中小人置灰效果
function updateModelDim(){
    const selVal = document.querySelector('input[name="modelSel"]:checked').value;
    for(let i=1;i<=3;i++){
        const wrap = document.getElementById("wrap"+i);
        if(String(i)!==selVal) wrap.classList.add("dim");
        else wrap.classList.remove("dim");
    }
}
radios.forEach(r=>r.onchange = updateModelDim);
updateModelDim();

// 加号打开弹窗
document.querySelectorAll('.add-btn').forEach(btn=>{
    btn.onclick=()=>{
        currentAddType = btn.dataset.type;
        modal.classList.add("active");
        detectResultText.textContent="";styleInput.value="";imgFileInput.value="";
    }
})

// 图片自动识别明暗
imgFileInput.onchange = e=>{
    const file = e.target.files[0];
    const reader = new FileReader();
    reader.onload = evt=>{
        const img = new Image();
        img.src = evt.target.result;
        img.onload = ()=>{
            const c = document.createElement('canvas');
            const ctx = c.getContext('2d');
            c.width = img.width;c.height = img.height;
            ctx.drawImage(img,0,0);
            const imgData = ctx.getImageData(0,0,c.width,c.height);
            let sum=0;
            for(let i=0;i<imgData.data.length;i+=4){
                const r=imgData.data[i],g=imgData.data[i+1],b=imgData.data[i+2];
                sum += 0.299*r + 0.587*g + 0.114*b;
            }
            const avg = sum/(imgData.data.length/4);
            const isLight = avg>130 ? 1 :0;
            detectResultText.textContent = avg>130 ? "✅识别：淡色系":"✅识别：深色系";
            document.getElementById("saveCloth").onclick = ()=>{
                const s = styleInput.value.trim();
                if(!s){alert("填写风格标签");return;}
                wardrobe.push({type:currentAddType,light:isLight,style:s.split(",")});
                alert(`✅衣橱共${wardrobe.length}件单品`);
                modal.classList.remove("active");
            }
        }
    }
    reader.readAsDataURL(file);
}

//生成穿搭，只更新选中小人
document.getElementById('genOutfitBtn').onclick = ()=>{
    const selStyle = document.getElementById('styleSelect').value;
    const rule = styleRule[selStyle];
    const selVal = document.querySelector('input[name="modelSel"]:checked').value;
    document.getElementById("layerTop"+selVal).className = "pixel-layer top "+rule.top;
    document.getElementById("layerBottom"+selVal).className = "pixel-layer bottom "+rule.bottom;
    alert("🎀已为选中小人生成【"+document.getElementById('styleSelect').selectedOptions[0].text+"】穿搭");
}
//切换场景，全部小人同步背景
document.getElementById('sceneSelect').onchange = function(){
    const sc = this.value;
    for(let i=1;i<=3;i++) document.getElementById("sceneBg"+i).className = "scene-bg "+sc;
}
//默认场景
for(let i=1;i<=3;i++) document.getElementById("sceneBg"+i).classList.add("scene-bedroom");
</script>
</body>
</html>
